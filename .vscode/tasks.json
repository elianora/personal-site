{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Site",
      "type": "shell",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      },
      "command": "nix",
      "args": [
        "run",
        "path:${workspaceFolder}",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Serve Site",
      "type": "shell",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      },
      "command": "nix",
      "args": [
        "run",
        "path:${workspaceFolder}",
        "serve",
        "--",
        "--watch",
        "--drafts"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}
